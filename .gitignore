/.hifz-env/
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/

# Widget Preview related
.widget_preview/

# Local licensed content and generated mixed-source data
/assets/data/*.db*
/assets/data/*.zip
/data/sources/*.zip
/assets/quran_fonts/*
/assets/tajweed/*
/assets/tafsir/*
!/assets/quran_fonts/.gitkeep
!/assets/tajweed/.gitkeep
!/assets/tafsir/.gitkeep
*.jks
*.keystore
*.apk
*.aab
.env
.env.*
